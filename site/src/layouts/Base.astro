---
// Every page: a Board UI root (<html class="bui">) in Salvo Bay's diorama palette. The theme is
// shared with the DOM VIRUS family (localStorage "dom-virus:theme"): night (dark) by default.
import '@fzlt/core/ui/board-ui.css';
import '../styles/site.css';
import { VERSION, REPO, HUB, base } from '../site';
const { title, description, page = 'home', app = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Staging and PR previews (Cloudflare, PUBLIC_DEPLOY_TARGET=staging) stay out of search.
const noindex = import.meta.env.PUBLIC_DEPLOY_TARGET === 'staging';
---
<!doctype html>
<html lang="en" class="bui" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={app ? "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" : "width=device-width, initial-scale=1, viewport-fit=cover"} />
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#141a2c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(base('shots/og.png'), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={base('icon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        var t = localStorage.getItem("dom-virus:theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body data-page={page} data-app={app ? "" : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href={base()} aria-label="Salvo Bay home"><img src={base('icon.svg')} alt="" width="36" height="36" /><span><b>SALVO BAY</b><small>V{VERSION} · BY CHRIS COOLEY</small></span></a>
        <nav class="site-nav" aria-label="Site">
          <a href={base('#how')}>How to play</a>
          <a href={base('#built')}>Built on Fizlet</a>
          <a href={HUB}>DOM VIRUS ↗</a>
        </nav>
        <div class="head-keys">
          <a class="bui-key bui-icon-key" href={REPO} aria-label="Source on GitHub">GH</a>
          <button class="bui-key bui-icon-key" type="button" data-theme-toggle aria-label="Switch day or night"><span class="theme-dark">☾</span><span class="theme-light">☀</span></button>
          <a class="bui-key play-key" href={base('play/')}>PLAY</a>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    {!app && <footer class="site-foot"><div class="wrap"><p><b>Salvo Bay</b> · a ship-hunting duel on a tabletop, by <a href="https://coded.design/">Chris Cooley</a>. Built on <a href="https://github.com/fizlet/fzlt">Fizlet</a>, no libraries. All rights reserved · <a href={REPO}>source</a> · <a href={`${REPO}/blob/main/CHANGELOG.md`}>release notes</a> · part of the <a href={HUB}>DOM VIRUS</a> family.</p><p>© 2026 coded.design</p></div></footer>}
    <script is:inline>
      document.querySelector("[data-theme-toggle]").addEventListener("click", function () {
        var r = document.documentElement, t = r.dataset.theme === "light" ? "dark" : "light";
        r.dataset.theme = t;
        try { localStorage.setItem("dom-virus:theme", t); } catch (e) {}
      });
    </script>
  </body>
</html>
